{
  "name": "leftist-ideology-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An adaptive test that places a respondent among leftist ideologies.",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "lint:content": "tsx scripts/lint-content.ts",
    "coverage": "tsx scripts/coverage.ts",
    "stats": "tsx scripts/stats.ts",
    "trace": "tsx scripts/trace.ts",
    "check": "tsx scripts/check.ts",
    "roster:todo": "tsx scripts/roster-todo.ts",
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "ci": "npm run validate && npm run lint:content && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^22.10.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
